{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(pnpm *)",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(perl *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sed *)",
      "Bash(grep *)",
      "Bash(awk *)",
      "Bash(xargs *)",
      "Bash(xxd *)",
      "Bash(tee *)",
      "Bash(sqlite3 *)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(cat *)",
      "Bash(cp *)",
      "Bash(rm *)",
      "Bash(mkdir *)",
      "Bash(echo *)",
      "Bash(findstr *)",
      "Bash(tasklist *)",
      "Bash(netstat *)",
      "Bash(timeout *)",
      "Bash(break)",
      "Bash(cd *)",
      "Bash(command -v *)",
      "Bash(jq *)",
      "PowerShell(npx *)",
      "PowerShell(pnpm *)",
      "PowerShell(npm run *)",
      "PowerShell(git *)",
      "PowerShell(Get-*)",
      "PowerShell(Stop-Process *)",
      "PowerShell(Start-Process *)",
      "PowerShell(netstat *)",
      "WebSearch",
      "WebFetch(domain:ogame.fandom.com)",
      "WebFetch(domain:ogame-wiki.net)",
      "WebFetch(domain:www.ogame.in)",
      "WebFetch(domain:board.ogame.gameforge.com)",
      "WebFetch(domain:en.m.wikipedia.org)",
      "WebFetch(domain:www.ghiroblu.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Read(//d//**)",
      "Read(//c/Users/Utilisateur/**)",
      "Read(//tmp/**)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "mcp__Claude_Preview__preview_start",
      "mcp__visualize__read_me",
      "mcp__visualize__show_widget",
      "mcp__Claude_in_Chrome__list_connected_browsers",
      "mcp__Claude_in_Chrome__select_browser",
      "mcp__Claude_in_Chrome__navigate",
      "mcp__Claude_in_Chrome__get_page_text"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-git-write.js"
          }
        ]
      },
      {
        "matcher": "mcp__computer-use__open_application",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-chrome-open.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ts-edit-nag.js"
          }
        ]
      }
    ]
  }
}
